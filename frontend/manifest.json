{
  "manifest_version": 3,
  "name": "Web.AI",
  "version": "1.0",
  "description": "AI-powered assistant for analyzing web pages",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png",
    "default_title": "Web.AI"
  },
  "icons": {
    "128": "icon.png"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5000/*"
    ]
  }
}
